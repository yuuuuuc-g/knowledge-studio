PORT=8787
WEB_ORIGIN=http://127.0.0.1:5173

# Keep real secrets here in apps/api/.env, never in frontend code.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash

# Supabase persistent resource storage.
# Use the service role key only on the backend. Never expose it in frontend env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESOURCES_TABLE=knowledge_resources
SUPABASE_STORAGE_BUCKET=knowledge-resource-files
